{
  "rules": {
    ".read": true,
    ".write": false,

    "match": {
      "current": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['teamA','teamB','format']) || !newData.exists()"
      }
    },

    "history": {
      "$entryId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "bracket": {
      "current": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "admins": {
      ".read": true,
      ".write": false
    }
  }
}
